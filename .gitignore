/target
**/*.rs.bk
Cargo.lock.orig

# Game save fixtures are user data and must not be committed.
/tests/fixtures/*.sav
/tests/fixtures/*.bin
/tests/fixtures/**/*.sav

# kittest snapshot artifacts
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.diff.png

# Snapshot-tool backups
*.old.png

# Stray per-screen review renders (the snapshot tool must not write tracked paths)
**/tests/snapshots/review/

# Stray backup files
*.bak

# Review/design artifacts (mockups, bundles)
/artifacts/

# Stray snapshot archive (kept on disk, not tracked)
snapshots.zip
